---
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';
import ArticleItem from '../components/ArticleItem.astro';
import Card from '../components/Card.astro';
import { MASCOTS, SITE } from '../consts';
import { getArticles, getProjects } from '../utils';

const recent = (await getArticles()).slice(0, 4);
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 2);
---
<Layout pageTitle={SITE.title}>
    <Mascot src={MASCOTS.home} />
    <h1>{SITE.title}</h1>
    <span class="badge">{SITE.role}</span>
    <h2>About</h2>
    <p>
        Hi, I'm {SITE.author}. Write a couple of sentences about yourself here: what you work on,
        what you're learning, and what readers will find on this site.
    </p>
    <p>
        This blog collects my projects, notes on security and software engineering, and
        writeups for retired HackTheBox machines.
    </p>

    {featured.length > 0 && (
        <>
            <h2>Featured projects</h2>
            <ul role="list" class="link-card-grid">
                {featured.map((card) => <Card
                    url={`/projects/${card.id}/`}
                    image={card.data.image?.url}
                    title={card.data.title}
                    body={card.data.description}
                />)}
            </ul>
        </>
    )}

    {recent.length > 0 && (
        <>
            <h2>Recent</h2>
            <ul role="list" class="article-list">
                {recent.map((entry) => <ArticleItem entry={entry} showKind />)}
            </ul>
            <div class="center">
                <a class="btn" href="/posts/">All posts</a>
                <a class="btn" href="/writeups/">All writeups</a>
            </div>
        </>
    )}

    <h2>Skills</h2>
    <div class="skills center">
        <img class="skills__img" width="46" height="46" alt="Python" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/python/python-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Bash" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/bash/bash-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Linux" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/linux/linux-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Go" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/go/go-original-wordmark.svg"/>
        <img class="skills__img" width="46" height="46" alt="TypeScript" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/typescript/typescript-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Docker" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/docker/docker-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Git" src="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/icons/git/git-original.svg"/>
    </div>
</Layout>
