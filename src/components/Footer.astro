---
import { SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---
<footer>
    <div class="center">
        <ul class="footer">
            <li class="icon__btn"><a class="icon__link" href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub"><span class="git-icon">GitHub</span></a></li>
            <li class="icon__btn"><a class="icon__link" href={`mailto:${SOCIALS.email}`} aria-label="Email"><span class="mail-icon">Email</span></a></li>
            <li class="icon__btn"><a class="icon__link" href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><span class="linked-in">LinkedIn</span></a></li>
            <li class="icon__btn"><a class="icon__link" href="/rss.xml" aria-label="RSS feed"><svg class="rss-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><circle cx="5" cy="19" r="2.2"/><path d="M3 10.5v3a7.5 7.5 0 0 1 7.5 7.5h3A10.5 10.5 0 0 0 3 10.5Zm0-6v3A13.5 13.5 0 0 1 16.5 21h3A16.5 16.5 0 0 0 3 4.5Z"/></svg></a></li>
        </ul>
        <small>&copy; {year} {SITE.author}. Theme based on <a class="footer__link" href="https://github.com/ttomczak3/Milky-Way" target="_blank" rel="noopener">Milky-Way</a> by ttomczak.</small>
    </div>
</footer>
