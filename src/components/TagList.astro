---
import { slugifyTag } from '../utils';

interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---
{tags.length > 0 && (
    <ul class="tag-list">
        {tags.map((tag) => (
            <li><a class="tag" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a></li>
        ))}
    </ul>
)}
